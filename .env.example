# Copy to .env for local dev (or set these in your AWS environment).

# Port the server listens on.
PORT=3000

# Secret token that protects the /admin dashboard and CSV export.
# CHANGE THIS to a long random string before deploying.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Where the data file lives. In Docker/AWS, point this at a persistent volume
# (e.g. /app/data/study.json) so data survives restarts. The event log is
# written beside it as events.jsonl.
DB_PATH=./data/study.json
